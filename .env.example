# Server & Database Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberforce_monitoring

# Database Connection Parameters (Used if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyberforce_monitoring
DB_USER=postgres
DB_PASSWORD=postgres

# Monitoring Configuration
MONITORING_INTERVAL_MINUTES=15
DAILY_SNAPSHOT_CRON="5 0 * * *"
ALERT_DEFAULT_COOLDOWN_MINUTES=360
REQUEST_TIMEOUT_MS=10000

# 1. AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# 2. MongoDB Atlas Credentials
MONGODB_ATLAS_ORG_ID=
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=

# 3. Redis Credentials
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. LiveKit Credentials
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=https://livekit.example.com

# 5. ElevenLabs Credentials
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io
ELEVENLABS_WEBHOOK_SECRET=

# 6. OpenAI Credentials
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# 7. Voyage AI Credentials
VOYAGEAI_API_KEY=

# 8. Face++ Credentials
FACEPLUSPLUS_API_KEY=
FACEPLUSPLUS_API_SECRET=

# 9. Deepgram Credentials
DEEPGRAM_API_KEY=
DEEPGRAM_SECRET_KEY=
DEEPGRAM_PROJECT_ID=

# 10. Apollo.io Credentials
APOLLO_API_KEY=

# 11. Twilio Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# 12. Plivo Credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Alerting Channels - Email
ALERT_EMAIL=alerts@cyberforce.internal
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CyberForce Monitor <alerts@cyberforce.internal>"

# Alerting Channels - Webhook (Slack/Discord/Custom)
ALERT_WEBHOOK_URL=
